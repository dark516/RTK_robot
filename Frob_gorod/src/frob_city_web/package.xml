<?xml version="1.0"?>
<package format="3">
  <name>frob_city_web</name>
  <version>0.1.0</version>
  <description>Read-only Frob City telemetry dashboard with mission-level controls.</description>
  <maintainer email="maintainer@example.com">Frob City Team</maintainer>
  <license>Apache-2.0</license>

  <depend>ament_index_python</depend>
  <depend>rclpy</depend>
  <depend>frob_city_interfaces</depend>
  <depend>frob_city_navigation</depend>
  <exec_depend>frob_bringup</exec_depend>
  <exec_depend>frob_navigation</exec_depend>
  <exec_depend>traffic_sign_detector</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
